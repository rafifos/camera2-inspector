    <!-- Notas de disponibilidade -->
    <string name="availability_characteristics">Valor lido de CameraCharacteristics para esta câmera. Erros de leitura são registrados por key.</string>
    <string name="availability_capture_request">Reportada pelo dispositivo como CaptureRequest key disponível. A presença não significa que o app conhece valores válidos nem que a key é gravável; nenhum CaptureRequest é enviado por este app.</string>
    <string name="availability_capture_result">Reportada pelo dispositivo como CaptureResult key disponível. Resultados são saídas do pipeline da câmera, não configuração.</string>
    <string name="availability_physical_request">Reportada pelo dispositivo como physical camera CaptureRequest key disponível. Aplica-se aos physical camera IDs associados a esta câmera lógica, quando o dispositivo os reporta.</string>
    <string name="availability_session">Reportada pelo dispositivo como session key disponível (availableSessionKeys). Nenhuma sessão é criada e nenhum valor é alterado por este app.</string>

