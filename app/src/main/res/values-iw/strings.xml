    <string name="availability_capture_request">דווח על ידי המכשיר כמפתח CaptureRequest זמין.נוכחות לא אומרת שהאפליקציה הזו יודעת ערכים חוקיים, וגם לא שהמפתח ניתן לכתיבה;לא נשלחת CaptureRequest על ידי אפליקציה זו.</string>
    <string name="availability_capture_result">דווח על ידי המכשיר כמפתח CaptureResult זמין.התוצאות הן פלטים של צינור המצלמה, לא תצורה.</string>
    <string name="availability_physical_request">דווח על ידי המכשיר כמפתח CaptureRequest של מצלמה פיזית זמינה.זה חל על מזהי המצלמה הפיזיים המשויכים למצלמה הלוגית הזו, כאשר המכשיר מדווח עליהם.</string>
    <string name="availability_session">דווח על ידי המכשיר כמפתח הפעלה זמין (availableSessionKeys).לא נוצרה הפעלה ושום ערך לא שונה על ידי אפליקציה זו.</string>

    
